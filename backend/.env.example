GROQ_API_KEY=your_groq_api_key_here
SARVAM_API_KEY=your_sarvam_api_key_here

# Groq fallback chain, tried left to right (verify these IDs in the Groq console)
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=30
MODEL_COOLDOWN_SECONDS=60
SARVAM_TRANSLATE_MODEL=mayura:v1

# Next.js dev server + Vite
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Repo root (default: the folder above backend/)
# REPO_ROOT=/path/to/weather-downscaling
# 1 = also run the U-Net live for dates outside outputs/prediction_test.npz (needs torch + data/raw)
ENABLE_LIVE_INFERENCE=0
# 1 = refuse to answer when a panchayat can only be placed at district/block level
REQUIRE_EXACT_LOCATION=0